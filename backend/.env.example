NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Direct database URL used for schema migrations.
DIRECT_URL=postgresql://postgres:URL_ENCODED_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=4000
UPLOAD_DIR=uploads
RESUME_DIR=/tmp/skillswap-resumes
EMAIL_VERIFY_BASE_URL=http://localhost:5173/verify-email
EMAIL_FROM=SkillSwap <noreply@your-domain.example>
RESEND_API_KEY=re_replace_with_resend_api_key
LOG_LEVEL=info
TRUST_PROXY=false
